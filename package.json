{
  "name": "paperclip-plugin-telegram",
  "version": "0.8.1",
  "type": "module",
  "main": "./dist/index.js",
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "build": "tsc && esbuild src/ui/index.tsx --bundle --format=esm --platform=browser --outfile=dist/ui/index.js --sourcemap --external:react --external:react/jsx-runtime --external:react-dom --external:@paperclipai/plugin-sdk --external:@paperclipai/plugin-sdk/ui && node scripts/assert-single-ui-entry.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@paperclipai/plugin-sdk": "*",
    "@paperclipai/shared": "*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "^2026.722.0",
    "@paperclipai/shared": "^2026.722.0",
    "esbuild": "0.28.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvanhorn/paperclip-plugin-telegram.git"
  },
  "license": "MIT",
  "overrides": {
    "esbuild": "0.28.1",
    "nanoid": "3.3.18"
  }
}
