{
  "name": "paperclip-plugin-telegram",
  "version": "0.7.1",
  "type": "module",
  "main": "./dist/index.js",
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutations": "node scripts/mutation-check.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@paperclipai/plugin-sdk": "*",
    "@paperclipai/shared": "*",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@paperclipai/plugin-sdk": "^2026.722.0",
    "@paperclipai/shared": "^2026.722.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.8",
    "@vitest/coverage-v8": "^3.2.7",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvanhorn/paperclip-plugin-telegram.git"
